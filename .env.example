# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# Only the live-API integration suite (tests/integration/) reads these; the
# default hermetic `pytest` run needs none of them.

# Anthropic API key. The suite skips entirely without it; `Anthropic()` reads
# it implicitly.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model for the cold/warm prompt-cache calls. Default: claude-haiku-4-5.
LIVE_CACHE_MODEL=claude-haiku-4-5

# Spend guardrail for one integration run, in USD. Default: 0.10.
LIVE_CACHE_BUDGET_USD=0.10
